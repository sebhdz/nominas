---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
const { title = '¿Cuánto gana mi profe?', showDefinitions = true, skipTarget = 'search' } = Astro.props;
const description = 'Sueldos de profesores y funcionarios. Se pagan con dinero público, así que se leen con ojos públicos.';
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#eae2d2">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href={`#${skipTarget}`}>Ir al contenido principal</a>
  <header class="tape" aria-label="Información pública">
    <div class="marquee-track" aria-hidden="true"><span>Información pública · Información pública · Información pública · Información pública · Información pública · Información pública · </span><span>Información pública · Información pública · Información pública · Información pública · Información pública · Información pública · </span></div>
  </header>
  <slot />
  <Footer showDefinitions={showDefinitions} />
</body>
</html>
