---
import Page from "../layouts/Page.astro";
---
<Page title="Nómina · ¿Cuánto gana mi profe?">
  <Fragment slot="head"><script>import "../scripts/search.js";</script></Fragment>
  <main class="page">
    <section class="hero" aria-labelledby="titulo">
      <p id="university-name" class="project-name">Nómina</p>
      <a class="university-back" href="/">Buscar otra universidad</a>
      <h1 id="titulo">¿Cuánto gana<br><span class="headline-accent">mi profe?</span></h1>
      <div class="hero-bottom"><p class="intro-copy">Sueldos de profesores y funcionarios. Se pagan con dinero público, así que se leen con ojos públicos.</p></div>
    </section>
    <p id="university-error" role="status" hidden></p>
    <section id="payroll-search" class="search-section" aria-label="Buscar en la nómina">
      <form id="search-form" role="search" autocomplete="off">
        <label class="search-label" for="search">Busca a tu profe</label>
        <div class="search-box"><input id="search" type="search" name="q" placeholder="Nombre, puesto o departamento" aria-controls="results" maxlength="120" spellcheck="false" enterkeyhint="search"><button class="primary-button" type="submit">Ver sueldo</button></div>
      </form>
      <div class="filters" aria-label="Filtros de resultados">
        <div class="quick-filters" role="group" aria-label="Tipo de puesto"><button class="filter-button" type="button" data-group="all" aria-pressed="true">Todos</button><button class="filter-button" type="button" data-group="professors" aria-pressed="false">Profesores</button><button class="filter-button" type="button" data-group="others" aria-pressed="false">Otros puestos</button></div>
        <div class="area-combo"><label class="sr-only" for="area-input">Área o departamento</label><input id="area-input" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="area-list" placeholder="Todas las áreas" maxlength="120" spellcheck="false" autocomplete="off" disabled><ul id="area-list" role="listbox" aria-label="Áreas" hidden></ul><input id="area" type="hidden"></div>
        <label class="sr-only" for="order">Ordenar por sueldo bruto</label><select id="order"><option value="desc">Mayor a menor</option><option value="asc">Menor a mayor</option></select>
        <button id="reset" class="text-button" type="button" hidden>Limpiar</button>
      </div>
    </section>
    <section id="payroll-results" class="browse" aria-label="Resultados de búsqueda">
      <aside class="opinion-notice" aria-label="Cómo opinar sobre tu profesor">
        <strong>Ahora te toca opinar.</strong>
        <p>Toca un nombre para abrir su ficha y opinar sobre tu profe.</p>
      </aside>
      <p class="sort-note">Ordenado por sueldo bruto, de mayor a menor · MXN</p>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Sueldos de profesores y funcionarios"><div class="mobile-table-heading" aria-hidden="true"><span>Info</span><span>Sueldo mensual</span></div><table class="payroll-table"><caption class="sr-only">Sueldos mensuales de profesores y funcionarios. Selecciona un nombre para ver su ficha.</caption><thead><tr><th scope="col">Nombre</th><th scope="col">Puesto</th><th scope="col">Área / departamento</th><th scope="col" class="salary-heading">Sueldo mensual</th></tr></thead><tbody id="results" aria-busy="true"></tbody></table></div>
      <div class="results-footer"><p id="status" role="status" aria-live="polite">Cargando los datos públicos…</p><nav id="pagination" class="pagination" aria-label="Páginas de resultados" hidden><button id="previous-page" class="text-button" type="button">Anterior</button><span id="page-label"></span><button id="next-page" class="text-button" type="button">Siguiente</button></nav></div>
    </section>
  </main>
  <dialog id="person-dialog" aria-labelledby="person-name">
    <div class="dialog-top"><span class="eyebrow">REMUNERACIÓN MENSUAL</span><button id="close-dialog" class="close-button" aria-label="Cerrar ficha" type="button">✕</button></div>
    <div class="person-content"><p id="person-period" class="person-period"></p><h2 id="person-name"></h2><p id="person-role" class="person-role"></p><p id="person-area" class="person-area"></p>
      <div class="salaries"><div><span class="salary-label">BRUTO MENSUAL</span><strong id="person-gross"></strong><p>Antes de deducciones</p></div><div><span class="salary-label">NETO MENSUAL</span><strong id="person-net"></strong><p>Después de deducciones</p></div></div>
      <p class="currency-note">Pesos mexicanos (MXN). Importes mensuales reportados, no acumulados del periodo informado.</p>
      <div class="vote-verification">
        <div id="vote-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ''}></div>
        <p id="vote-verification-status" role="status" aria-live="polite" hidden>
          <span id="vote-verification-spinner" class="verification-indicator" aria-hidden="true" hidden><svg class="verification-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" opacity=".2"/><path d="M12 3a9 9 0 0 1 9 9" stroke-linecap="round"/></svg></span>
          <span id="vote-verification-message"></span>
        </p>
        <button id="retry-verification" class="text-button" type="button" hidden>Reintentar verificación</button>
      </div>
      <section class="recommend-card" aria-labelledby="recommend-title">
        <div class="recommend-header">
          <span id="recommend-title" class="recommend-title">¿RECOMIENDAS A ESTE PROFESOR?</span>
          <span id="recommend-badge" class="recommend-badge" aria-live="polite">Sin opiniones</span>
        </div>
        <div class="recommend-actions" role="group" aria-label="Recomendar o no al docente">
          <button id="vote-recommend-yes" disabled class="recommend-btn" type="button" data-choice="yes" aria-pressed="false">
            <svg class="recommend-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v10H3V10zM7 10l5-7a2 2 0 0 1 2 2l-1 5h6a2 2 0 0 1 2 2l-1 6a2 2 0 0 1-2 2H7"/></svg>
            <span class="recommend-text">Sí, lo recomiendo</span>
            <span id="count-rec-yes" class="recommend-count">0</span>
          </button>
          <button id="vote-recommend-no" disabled class="recommend-btn" type="button" data-choice="no" aria-pressed="false">
            <svg class="recommend-icon recommend-icon-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v10H3V10zM7 10l5-7a2 2 0 0 1 2 2l-1 5h6a2 2 0 0 1 2 2l-1 6a2 2 0 0 1-2 2H7"/></svg>
            <span class="recommend-text">No lo recomiendo</span>
            <span id="count-rec-no" class="recommend-count">0</span>
          </button>
        </div>
        <p id="recommend-status" class="recommend-status" role="status" aria-live="polite"></p>
      </section>
      <section class="perception-card" aria-labelledby="perception-title">
        <div class="perception-header">
          <span id="perception-title" class="perception-title">¿QUÉ OPINAS DE ESTE SUELDO?</span>
          <span id="perception-total" class="perception-total" aria-live="polite">0 opiniones</span>
        </div>
        <div class="perception-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Distribución de opiniones">
          <div id="bar-more" class="bar-segment bar-more" style="width: 0%"></div>
          <div id="bar-fair" class="bar-segment bar-fair" style="width: 0%"></div>
          <div id="bar-less" class="bar-segment bar-less" style="width: 0%"></div>
        </div>
        <div class="perception-actions" role="group" aria-label="Opciones de percepción sobre el sueldo">
          <button id="vote-more" disabled class="perception-btn" type="button" data-choice="more" aria-pressed="false">
            <span class="btn-dot dot-more" aria-hidden="true"></span>
            <span class="btn-text">Merece más</span>
            <span id="count-more" class="btn-count">0</span>
          </button>
          <button id="vote-fair" disabled class="perception-btn" type="button" data-choice="fair" aria-pressed="false">
            <span class="btn-dot dot-fair" aria-hidden="true"></span>
            <span class="btn-text">Me parece justo</span>
            <span id="count-fair" class="btn-count">0</span>
          </button>
          <button id="vote-less" disabled class="perception-btn" type="button" data-choice="less" aria-pressed="false">
            <span class="btn-dot dot-less" aria-hidden="true"></span>
            <span class="btn-text">Merece menos</span>
            <span id="count-less" class="btn-count">0</span>
          </button>
        </div>
        <p id="perception-status" class="perception-status" role="status" aria-live="polite"></p>
      </section>
      <div class="person-source"><span id="person-source-date"></span><button id="share-person" class="text-button" type="button">Copiar enlace</button></div>
      <p id="share-status" class="share-status" role="status"></p><a class="source-reference" href="https://consultapublicamx.plataformadetransparencia.org.mx" target="_blank" rel="noopener noreferrer">Consultar la fuente oficial</a>
    </div>
  </dialog>
  <noscript><p class="page">Activa JavaScript para usar el buscador de nóminas.</p></noscript>
</Page>
