---
import Page from "../layouts/Page.astro";
import RecordsTable from "../components/RecordsTable.astro";
---
<Page title="Nómina · ¿Cuánto gana mi profe?">
  <Fragment slot="head"><script>import "../scripts/search.js";</script></Fragment>
  <main class="page">
    <section class="hero" aria-labelledby="titulo">
      <p id="university-name" class="project-name">Nómina</p>
      <a class="university-back" href="/">Buscar otra universidad</a>
      <h1 id="titulo">¿Cuánto gana<br><span class="headline-accent">mi profe?</span></h1>
      <div class="hero-bottom"><p class="intro-copy">Sueldos de profesores y funcionarios. Se pagan con dinero público, así que se leen con ojos públicos.</p></div>
      <a class="methodology-link university-methodology" href="/metodologia/">¿Cómo obtenemos y presentamos estos datos?</a>
      <p class="legal-reference"><a href="/metodologia/">El artículo 6° constitucional</a> protege el derecho a acceder y difundir información pública. Aquí sólo hacemos más visible lo que las instituciones ya publicaron.</p>
    </section>
    <p id="university-error" role="status" hidden></p>
    <nav class="dataset-tabs" role="tablist" aria-label="Información de la universidad">
      <button id="payroll-tab" class="dataset-tab" type="button" role="tab" aria-selected="true" aria-controls="payroll-panel">Nómina</button>
      <button id="pensions-tab" class="dataset-tab" type="button" role="tab" aria-selected="false" aria-controls="pensions-panel" tabindex="-1" disabled hidden>Pensionados</button>
    </nav>
    <section id="search-section" class="search-section" aria-label="Buscar registros">
      <form id="search-form" role="search" autocomplete="off">
        <label id="search-label" class="search-label" for="search">Busca a tu profe</label>
        <div class="search-box"><input id="search" type="search" name="q" placeholder="Nombre, puesto o departamento" aria-controls="results" maxlength="120" spellcheck="false" enterkeyhint="search"><button id="search-submit" class="primary-button" type="submit">Ver sueldo</button></div>
      </form>
      <div class="filters" aria-label="Filtros de resultados">
        <div id="payroll-filters" class="quick-filters" role="group" aria-label="Tipo de puesto"><button class="filter-button" type="button" data-group="all" aria-pressed="true">Todos</button><button class="filter-button" type="button" data-group="professors" aria-pressed="false">Profesores</button><button class="filter-button" type="button" data-group="others" aria-pressed="false">Otros puestos</button></div>
        <div class="area-combo"><label class="sr-only" for="area-input">Área o departamento</label><input id="area-input" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="area-list" placeholder="Todas las áreas" maxlength="120" spellcheck="false" autocomplete="off" disabled><ul id="area-list" role="listbox" aria-label="Áreas" hidden></ul><input id="area" type="hidden"></div>
        <div id="pension-filters" class="pension-filters" hidden>
          <label class="sr-only" for="pension-type">Tipo de pensión</label><select id="pension-type"><option value="">Todos los tipos</option></select>
          <label class="sr-only" for="pension-status">Estatus</label><select id="pension-status"><option value="">Todos los estatus</option></select>
        </div>
        <label id="order-label" class="sr-only" for="order">Ordenar por sueldo bruto</label><select id="order"><option value="desc">Mayor a menor</option><option value="asc">Menor a mayor</option></select>
        <button id="reset" class="text-button" type="button" hidden>Limpiar</button>
      </div>
    </section>
    <section id="payroll-panel" class="browse" role="tabpanel" aria-labelledby="payroll-tab" aria-label="Nómina">
      <aside class="opinion-notice" aria-label="Cómo opinar sobre tu profesor">
        <strong>Ahora te toca opinar.</strong>
        <p>Toca un nombre para abrir su ficha y opinar sobre tu profe.</p>
      </aside>
      <p id="payroll-sort-note" class="sort-note">Ordenado por sueldo bruto, de mayor a menor · MXN</p>
      <RecordsTable bodyId="results" regionLabel="Sueldos de profesores y funcionarios" caption="Sueldos mensuales de profesores y funcionarios. Selecciona un nombre para ver su ficha." columns={['Nombre', 'Puesto', 'Área / departamento', 'Sueldo mensual']} mobileAmountLabel="Sueldo mensual" />
    </section>
    <section id="pensions-panel" class="browse" role="tabpanel" aria-labelledby="pensions-tab" aria-label="Pensionados" hidden>
      <p id="pension-sort-note" class="sort-note">Ordenado por monto reportado, de mayor a menor · MXN</p>
      <p id="pensions-unavailable" class="data-message" role="status" hidden>No hay datos de pensiones disponibles para esta universidad.</p>
      <RecordsTable wrapperId="pensions-table-wrap" bodyId="pension-results" regionLabel="Personas pensionadas" caption="Personas pensionadas; los montos y su periodicidad se muestran como los reporta la fuente." columns={['Nombre', 'Tipo de pensión', 'Área responsable', 'Monto reportado']} mobileAmountLabel="Monto reportado" hidden />
    </section>
    <div class="results-footer"><p id="status" role="status" aria-live="polite">Cargando los datos públicos…</p><nav id="pagination" class="pagination" aria-label="Páginas de resultados" hidden><button id="previous-page" class="text-button" type="button">Anterior</button><span id="page-label"></span><button id="next-page" class="text-button" type="button">Siguiente</button></nav></div>
  </main>
  <dialog id="person-dialog" aria-labelledby="person-name">
    <div class="dialog-top"><span class="eyebrow">NÓMINA PÚBLICA</span><button id="close-dialog" class="close-button" aria-label="Cerrar ficha" type="button">✕</button></div>
    <div class="person-content">
      <section class="person-identity">
        <h2 id="person-name"></h2>
        <div class="person-details"><p id="person-role" class="person-role"></p><p id="person-area" class="person-area"></p></div>
      </section>
      <section class="salary-summary" aria-label="Sueldo mensual reportado">
        <p class="salary-summary-title">SUELDO MENSUAL REPORTADO</p>
        <div class="salaries"><div><span class="salary-label">BRUTO</span><strong id="person-gross"></strong></div><div><span class="salary-label">NETO</span><strong id="person-net"></strong></div></div>
        <div class="salary-meta"><p class="currency-note">MXN · importes mensuales reportados.</p><p id="person-period" class="person-period"></p></div>
      </section>
      <section class="opinions-section" aria-label="Opiniones de visitantes">
        <p class="opinions-title">OPINIONES DE VISITANTES</p>
        <p class="opinion-context">Participación abierta de visitantes; no es una encuesta representativa.</p>
      <div class="vote-verification">
        <div id="vote-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ''}></div>
        <p id="vote-verification-status" role="status" aria-live="polite" hidden>
          <span id="vote-verification-spinner" class="verification-indicator" aria-hidden="true" hidden><svg class="verification-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" opacity=".2"/><path d="M12 3a9 9 0 0 1 9 9" stroke-linecap="round"/></svg></span>
          <span id="vote-verification-message"></span>
        </p>
        <button id="retry-verification" class="text-button" type="button" hidden>Reintentar verificación</button>
      </div>
      <section class="recommend-card" aria-labelledby="recommend-title">
        <div class="recommend-header">
          <span id="recommend-title" class="recommend-title">¿RECOMIENDAS A ESTA PERSONA EN ESTE CARGO?</span>
          <span id="recommend-badge" class="recommend-badge" aria-live="polite">Sin opiniones</span>
        </div>
        <div class="recommend-actions" role="group" aria-label="Recomendar o no a esta persona en su cargo">
          <button id="vote-recommend-yes" disabled class="recommend-btn" type="button" data-choice="yes" aria-pressed="false">
            <svg class="recommend-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v10H3V10zM7 10l5-7a2 2 0 0 1 2 2l-1 5h6a2 2 0 0 1 2 2l-1 6a2 2 0 0 1-2 2H7"/></svg>
            <span class="recommend-text">Sí, la recomendaría</span>
            <span id="count-rec-yes" class="recommend-count">0</span>
          </button>
          <button id="vote-recommend-no" disabled class="recommend-btn" type="button" data-choice="no" aria-pressed="false">
            <svg class="recommend-icon recommend-icon-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v10H3V10zM7 10l5-7a2 2 0 0 1 2 2l-1 5h6a2 2 0 0 1 2 2l-1 6a2 2 0 0 1-2 2H7"/></svg>
            <span class="recommend-text">No la recomendaría</span>
            <span id="count-rec-no" class="recommend-count">0</span>
          </button>
        </div>
        <p class="opinion-disclaimer">Refleja experiencias personales, no una evaluación oficial.</p>
        <p id="recommend-status" class="recommend-status" role="status" aria-live="polite"></p>
      </section>
      <section class="perception-card" aria-labelledby="perception-title">
        <div class="perception-header">
          <span id="perception-title" class="perception-title">¿CÓMO PERCIBES ESTE SUELDO?</span>
          <span id="perception-total" class="perception-total" aria-live="polite">0 opiniones</span>
        </div>
        <div class="perception-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Distribución de opiniones">
          <div id="bar-more" class="bar-segment bar-more" style="width: 0%"></div>
          <div id="bar-fair" class="bar-segment bar-fair" style="width: 0%"></div>
          <div id="bar-less" class="bar-segment bar-less" style="width: 0%"></div>
        </div>
        <div class="perception-actions" role="group" aria-label="Opciones de percepción sobre el sueldo">
          <button id="vote-more" disabled class="perception-btn" type="button" data-choice="more" aria-pressed="false">
            <span class="btn-dot dot-more" aria-hidden="true"></span>
            <span class="btn-text">Bajo</span>
            <span id="count-more" class="btn-count">0</span>
          </button>
          <button id="vote-fair" disabled class="perception-btn" type="button" data-choice="fair" aria-pressed="false">
            <span class="btn-dot dot-fair" aria-hidden="true"></span>
            <span class="btn-text">Adecuado</span>
            <span id="count-fair" class="btn-count">0</span>
          </button>
          <button id="vote-less" disabled class="perception-btn" type="button" data-choice="less" aria-pressed="false">
            <span class="btn-dot dot-less" aria-hidden="true"></span>
            <span class="btn-text">Alto</span>
            <span id="count-less" class="btn-count">0</span>
          </button>
        </div>
        <p class="opinion-disclaimer">Refleja una percepción personal; no determina si el salario es correcto.</p>
        <p id="perception-status" class="perception-status" role="status" aria-live="polite"></p>
      </section>
      </section>
      <section class="person-reference" aria-label="Fuente y acciones">
        <p id="person-source-date" class="source-date"></p>
        <div class="reference-actions"><a class="source-reference" href="https://consultapublicamx.plataformadetransparencia.org.mx" target="_blank" rel="noopener noreferrer">Consultar la fuente oficial</a><button id="share-person" class="text-button" type="button">Copiar enlace</button></div>
        <p id="share-status" class="share-status" role="status"></p>
      </section>
    </div>
  </dialog>
  <noscript><p class="page">Activa JavaScript para usar el buscador de nóminas.</p></noscript>
</Page>
